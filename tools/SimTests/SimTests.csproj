<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles Shared/** verbatim: the tests run the exact source the game ships, outside Unity.
       Not generated by Unity - Unity's .gitignore ignores *.csproj, so this file is force-added. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Satisfying.Tests</RootNamespace>
    <AssemblyName>SimTests</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Tests\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Assets\_Project\Scripts\Shared\**\*.cs" />
  </ItemGroup>

</Project>
