<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs a real server + predicting client + bots headlessly. Pulls in Shared/** plus the test
       harness (BoxWorld, NetHarness) but not SimTests' own Main. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Satisfying.Playground</RootNamespace>
    <AssemblyName>Playground</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\SimTests\BoxWorld.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\SimTests\NetHarness.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Assets\_Project\Scripts\Shared\**\*.cs" />
  </ItemGroup>

</Project>
